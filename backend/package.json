{
  "name": "3l-backend",
  "version": "1.0.0",
  "description": "Law school study app API backend",
  "main": "src/index.js",
  "scripts": {
    "build": "npx prisma generate",
    "start": "npm run build && npx prisma migrate deploy && node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "node src/db/init.js",
    "prisma:migrate": "npx prisma migrate deploy",
    "prisma:seed": "node prisma/seed.js",
    "prisma:studio": "npx prisma studio",
    "postinstall": "npx prisma skills sync || exit 0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.28.0",
    "@aws-sdk/client-s3": "^3.400.0",
    "@aws-sdk/s3-request-presigner": "^3.400.0",
    "@prisma/client": "^5.15.0",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.13.0",
    "pg": "^8.11.3",
    "prisma": "^5.15.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
